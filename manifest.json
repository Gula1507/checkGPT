{
  "manifest_version": 3,
  "name": "CheckGPT ",
  "version": "1.11",
  "description": "Test-Addon zur Berechnung von Tokens je Prompt",
  "permissions": [
    "tabs"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/co2Indicator.js",
        "src/content/promptDetector.js",
        "src/tokens/tokens.js"
      ],
      "css": []
    }
  ]
}