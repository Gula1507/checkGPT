{
  "manifest_version": 3,
  "name": "CheckGPT: CO2 Tracker",
  "version": "1.2",
  "description": "Berechnet den Energieverbrauch und CO2-Ausstoß von ChatGPT-Prompts in Echtzeit.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/co2Indicator.js",
        "src/content/promptDetector.js",
        "src/utils/tokens.js"
      ],
      "css": []
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/utils/calculator.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}